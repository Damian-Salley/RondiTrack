<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c16d6931-b886-4f90-9200-831d1c0c4550</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="RondiTrack.Domain\RondiTrack.Domain.csproj" />
    <ProjectReference Include="RondiTrack.Infrastructure\RondiTrack.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="RondiTrack.Tests/**/*.cs" />
    <Compile Remove="RondiTrack.Domain/**/*.cs" />
    <Compile Remove="RondiTrack.Infrastructure/**/*.cs" />

    <Content Remove="RondiTrack.Tests/**" />
    <Content Remove="RondiTrack.Domain/**" />
    <Content Remove="RondiTrack.Infrastructure/**" />

    <None Remove="RondiTrack.Tests/**" />
    <None Remove="RondiTrack.Domain/**" />
    <None Remove="RondiTrack.Infrastructure/**" />

    <EmbeddedResource Remove="RondiTrack.Tests/**" />
    <EmbeddedResource Remove="RondiTrack.Domain/**" />
    <EmbeddedResource Remove="RondiTrack.Infrastructure/**" />
  </ItemGroup>

</Project>